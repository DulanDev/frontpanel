{
  "name": "@frontpanel/css",
  "type": "module",
  "version": "0.5.0",
  "description": "Early-2000s hardware skin as plain CSS: liquid-chrome bezels, gel buttons, LCDs and LEDs. Tokens, classes and an optional Tailwind 4 entry.",
  "author": "Dulan Katukurundage",
  "license": "MIT",
  "homepage": "https://dulandev.github.io/frontpanel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DulanDev/frontpanel.git",
    "directory": "packages/css"
  },
  "keywords": ["css", "y2k", "skeuomorphic", "chrome", "ui-kit", "design-system", "tailwindcss"],
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./index.css",
    "./index.css": "./index.css",
    "./tokens.css": "./tokens.css",
    "./base.css": "./base.css",
    "./components.css": "./components.css",
    "./fonts.css": "./fonts.css",
    "./tailwind.css": "./tailwind.css",
    "./page.css": "./page.css",
    "./tailwind-page.css": "./tailwind-page.css",
    "./tailwind-base.css": "./tailwind-base.css"
  },
  "files": ["base.css", "components.css", "fonts", "fonts.css", "icons", "index.css", "page.css", "tailwind-base.css", "tailwind-page.css", "tailwind.css", "tokens.css"],
  "scripts": {
    "build": "node scripts/build.ts",
    "build:watch": "node scripts/build.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3"
  }
}
