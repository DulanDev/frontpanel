{
  "name": "@frontpanel/music",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Optional Frontpanel add-on: chord diagram, chord matrix and chord-type caps for music apps. Presentational only; you supply the chord data.",
  "author": "Dulan Katukurundage",
  "license": "MIT",
  "homepage": "https://dulandev.github.io/frontpanel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DulanDev/frontpanel.git",
    "directory": "packages/music"
  },
  "keywords": ["vue", "music", "guitar", "chord-diagram", "y2k", "ui-kit"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@frontpanel/css": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.3",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
